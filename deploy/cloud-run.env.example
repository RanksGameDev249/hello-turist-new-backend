# Google Cloud runtime values for Cloud Run.
# Put secrets in Secret Manager; do not commit real values.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Cloud SQL for PostgreSQL over the Cloud Run-mounted Unix socket.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@/DB_NAME?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Memorystore for Redis. Use the instance's private IP on the VPC.
REDIS_URL=redis://REDIS_PRIVATE_IP:6379

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
FIREBASE_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_PRIVATE_KEY=
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
