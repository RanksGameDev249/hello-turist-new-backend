DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/hello_kurukshetra
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
HOST=0.0.0.0
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# Google Maps Platform server APIs: Places API (New) + Routes API
# Keep this secret only on the backend; never commit the real value.
GOOGLE_MAPS_API_KEY=

# Ride pricing (server-authoritative, INR). Set these to the approved business rates.
RIDE_BASE_FARE_INR=
RIDE_PER_KM_FARE_INR=
RIDE_MINIMUM_FARE_INR=

# Payment webhook authentication secret. Keep this server-side only.
PAYMENT_WEBHOOK_SECRET=
