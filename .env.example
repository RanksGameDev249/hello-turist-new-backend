DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/hello_kurukshetra
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (admin panel included).
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
# Firebase Authentication / FCM service account (keep private; use a secret manager in production).
FIREBASE_PROJECT_ID=
FCM_SERVICE_ACCOUNT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SECRET_MANAGER_VALUE\n-----END PRIVATE KEY-----\n"
# Google Maps Platform server-side key. Restrict this key to the APIs used by this backend.
GOOGLE_MAPS_API_KEY=
RIDE_BASE_FARE_INR=
RIDE_PER_KM_FARE_INR=
RIDE_MINIMUM_FARE_INR=
# Razorpay production credentials and webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Backward-compatible alias; prefer RAZORPAY_WEBHOOK_SECRET.
PAYMENT_WEBHOOK_SECRET=
# Optional hardening: set a secret and add AdMob SSV verification before production wallet crediting.
WALLET_AD_REWARD_SECRET=
# Private Cloudflare R2/S3-compatible storage for ride recordings.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SERVER_SIDE_ENCRYPTION=AES256
RIDE_RECORDING_RETENTION_DAYS=30
# Safety monitor checks active rides for stale location/heartbeat updates.
SAFETY_MONITOR_INTERVAL_MS=60000
RIDE_HEARTBEAT_STALE_MS=120000
