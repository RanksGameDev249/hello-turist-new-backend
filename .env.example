DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/hello_kurukshetra
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
HOST=0.0.0.0
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me

# Google Sign-In: Android sends a Google ID token minted for this Web client ID.
GOOGLE_WEB_CLIENT_ID=

# Firebase Phone Authentication. Android sends a Firebase ID token after OTP verification.
FIREBASE_WEB_API_KEY=

# Google Maps Platform server APIs: Places API (New) + Routes API
GOOGLE_MAPS_API_KEY=

# Ride pricing (server-authoritative, INR)
RIDE_BASE_FARE_INR=
RIDE_PER_KM_FARE_INR=
RIDE_MINIMUM_FARE_INR=

# Razorpay server credentials. Never ship the secret to Android.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Existing internal webhook secret (legacy/provider adapters)
PAYMENT_WEBHOOK_SECRET=
