generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SupportTicket {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  subject   String
  category  String                @default("GENERAL")
  status    SupportTicketStatus   @default(OPEN)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  messages  SupportTicketMessage[]
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @map("ticket_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  message   String
  isStaff   Boolean       @default(false) @map("is_staff")
  createdAt DateTime      @default(now()) @map("created_at")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String
  username String @unique
  email String? @unique
  passwordHash String @map("password_hash")
  status UserStatus @default(ACTIVE)
  preferredLanguage String @default("en") @map("preferred_language")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  refreshSessions RefreshSession[]
  roles UserRoleAssignment[]
  verificationRequests VerificationRequest[]
  driverProfile DriverProfile?
  guideProfile GuideProfile?
  ridesAsRider Ride[] @relation("RideRider")
  rideEvents RideEvent[] @relation("RideEventActor")
  rideAssignments RideAssignment[] @relation("RideDriver")
  rideLocations RideLocation[] @relation("RideLocationDriver")
  payments Payment[] @relation("PaymentPayer")
  notifications Notification[]
  @@map("users")
}

model UserRoleAssignment {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  role UserRole
  verificationStatus String @default("PENDING") @map("verification_status")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RideEmergencyIncident {
  id String @id @default(uuid()) @db.Uuid
  rideId String @map("ride_id") @db.Uuid
  triggeredBy String @map("triggered_by") @db.Uuid
  reason String?
  status String @default("OPEN")
  acknowledgedBy String? @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedAt DateTime? @map("resolved_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([rideId, status])
  @@index([status, createdAt])
  @@map("ride_emergency_incidents")
}
