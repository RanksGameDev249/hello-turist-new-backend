generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  username             String                @unique
  email                String?               @unique
  passwordHash         String                @map("password_hash")
  status               UserStatus            @default(ACTIVE)
  preferredLanguage    String                @default("en") @map("preferred_language")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  refreshSessions      RefreshSession[]
  roles                UserRoleAssignment[]
  verificationRequests VerificationRequest[]
  driverProfile        DriverProfile?
  guideProfile         GuideProfile?

  @@map("users")
}

model UserRoleAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  role               UserRole
  verificationStatus String   @default("PENDING") @map("verification_status")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RefreshSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedByHash String?   @map("replaced_by_hash")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_refresh_sessions")
}

model RefreshTokenReuse {
  tokenHash  String   @id @map("token_hash")
  detectedAt DateTime @default(now()) @map("detected_at")

  @@map("auth_refresh_reuse")
}

model VerificationRequest {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  role            UserRole
  status          VerificationStatus        @default(PENDING)
  rejectionReason String?                   @map("rejection_reason")
  submittedAt     DateTime?                 @map("submitted_at")
  reviewedAt      DateTime?                 @map("reviewed_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps           VerificationStep[]
  documents       VerificationDocument[]
  liveSession     VerificationLiveSession?

  @@index([userId])
  @@index([status])
  @@index([role, status])
  @@map("verification_requests")
}

model VerificationStep {
  id                    String                  @id @default(uuid()) @db.Uuid
  verificationRequestId String                  @map("verification_request_id") @db.Uuid
  step                  VerificationStepType
  status                VerificationStepStatus @default(PENDING)
  completedAt           DateTime?               @map("completed_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  verificationRequest   VerificationRequest    @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@unique([verificationRequestId, step])
  @@index([verificationRequestId])
  @@map("verification_steps")
}

model VerificationDocument {
  id                    String             @id @default(uuid()) @db.Uuid
  verificationRequestId String             @map("verification_request_id") @db.Uuid
  documentType          String             @map("document_type")
  privateObjectKey      String             @map("private_object_key")
  checksum              String?
  expiryDate            DateTime?          @map("expiry_date")
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@index([verificationRequestId])
  @@index([verificationStatus])
  @@map("verification_documents")
}

model VerificationLiveSession {
  id                    String                  @id @default(uuid()) @db.Uuid
  verificationRequestId String                  @unique @map("verification_request_id") @db.Uuid
  providerReference     String                  @map("provider_reference")
  status                VerificationStepStatus @default(PENDING)
  startedAt             DateTime?               @map("started_at")
  completedAt           DateTime?               @map("completed_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  verificationRequest  VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@map("verification_live_sessions")
}

model DriverProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  bio               String?
  experienceYears   Int?     @map("experience_years")
  serviceCity       String?  @map("service_city")
  serviceArea       String?  @map("service_area")
  profileImageKey   String?  @map("profile_image_key")
  isAvailable       Boolean  @default(false) @map("is_available")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles          Vehicle[]

  @@index([serviceCity])
  @@index([isAvailable])
  @@map("driver_profiles")
}

model GuideProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  bio               String?
  experienceYears   Int?     @map("experience_years")
  serviceCity       String?  @map("service_city")
  profileImageKey   String?  @map("profile_image_key")
  languages         String[] @default([])
  specialties       String[] @default([])
  isAvailable       Boolean  @default(false) @map("is_available")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([serviceCity])
  @@index([isAvailable])
  @@map("guide_profiles")
}

model Vehicle {
  id                String        @id @default(uuid()) @db.Uuid
  driverProfileId   String        @map("driver_profile_id") @db.Uuid
  make              String
  model             String
  year              Int?
  registrationNumber String       @map("registration_number")
  vehicleType       VehicleType   @default(CAR) @map("vehicle_type")
  seatCount         Int           @map("seat_count")
  color             String?
  imageKey          String?       @map("image_key")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  driverProfile     DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@unique([registrationNumber])
  @@index([driverProfileId])
  @@index([isActive])
  @@map("vehicles")
}

enum VehicleType {
  CAR
  SUV
  SEDAN
  HATCHBACK
  VAN
  BUS
  OTHER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  DELETED
}

enum UserRole {
  RIDER
  DRIVER
  GUIDE
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
  RESUBMITTED
  SUSPENDED
  BLOCKED
}

enum VerificationStepType {
  PROFILE
  DOCUMENTS
  LIVE_SESSION
  REVIEW
}

enum VerificationStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}
