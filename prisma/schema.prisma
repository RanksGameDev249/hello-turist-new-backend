generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  username          String               @unique
  email             String?              @unique
  passwordHash      String               @map("password_hash")
  status            UserStatus           @default(ACTIVE)
  preferredLanguage String               @default("en") @map("preferred_language")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")
  refreshSessions   RefreshSession[]
  roles             UserRoleAssignment[]

  @@map("users")
}

model UserRoleAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  role               UserRole
  verificationStatus String   @default("PENDING") @map("verification_status")
  createdAt          DateTime @default(now()) @map("created_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RefreshSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  userId         String    @map("user_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedByHash String?   @map("replaced_by_hash")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_refresh_sessions")
}

model RefreshTokenReuse {
  tokenHash  String   @id @map("token_hash")
  detectedAt DateTime @default(now()) @map("detected_at")

  @@map("auth_refresh_reuse")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
  DELETED
}

enum UserRole {
  RIDER
  DRIVER
  GUIDE
  ADMIN
}
